<%= form_tag request.path,
             method: :get,
             class: "op-language-selector",
             data: { turbo: false, controller: "form-preview", "form-preview-url-value": request.path } do %>
  <%= hidden_field_tag :back_url, params[:back_url] if params[:back_url].is_a?(String) %>
  <%= label_tag :ui_language, t(:label_language), class: "sr-only" %>
  <%= select_tag :ui_language,
                 options_for_select(lang_options_for_select(false), I18n.locale.to_s),
                 class: "form--select",
                 data: { action: "change->form-preview#submit" } %>
  <%= submit_tag t(:button_apply), name: nil, class: "button -small" %>
<% end %>
